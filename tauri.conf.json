{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CONCOSTCAD",
  "version": "0.1.0",
  "identifier": "vn.concostcad.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "dist"
  },
  "app": {
    "windows": [{
      "title": "CONCOSTCAD",
      "backgroundColor": "#252525",
      "width": 1440,
      "height": 900,
      "minWidth": 1024,
      "minHeight": 680,
      "decorations": false,
      "maximized": true,
      "visible": false,
      "resizable": true,
      "minimizable": true,
      "maximizable": true,
      "closable": true
    }],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": ["nsis", "msi"], "icon": ["icons/icon.ico"] }
}
